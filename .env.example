# Azure Bot / Entra ID app registration
clientId=00000000-0000-0000-0000-000000000000
clientSecret=your-client-secret
tenantId=00000000-0000-0000-0000-000000000000

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Lagring av samtalehistorikk: file (standard), blob, cosmos eller memory
STORAGE_TYPE=file
STORAGE_FOLDER=./data
# STORAGE_TYPE=blob
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
# BLOB_CONTAINER=teams-agent-state
# STORAGE_TYPE=cosmos
# COSMOS_ENDPOINT=https://<konto>.documents.azure.com:443/
# COSMOS_KEY=...
# COSMOS_DATABASE=teams-agent
# COSMOS_CONTAINER=state

# Valgfritt
PORT=3978
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
SYSTEM_PROMPT=

# Kun for deploy/azure-container-apps.sh
BOT_NAME=
BOT_RESOURCE_GROUP=
